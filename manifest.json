{
  "manifest_version": 3,
  "name": "Nova Debug",
  "version": "1.0.2",
  "description": "Nova Debug 서버 응답을 DevTools 패널에서 조회",
  "devtools_page": "devtools/devtools.html",
  "background": {
    "service_worker": "background/main.js"
  },
  "action": {
    "default_title": "Nova Debug",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16-off.png",
      "32": "icons/icon32-off.png",
      "48": "icons/icon48-off.png",
      "128": "icons/icon128-off.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "현재 사이트 Nova Debug on/off"
    }
  },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess", "scripting", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
