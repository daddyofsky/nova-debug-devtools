{
  "manifest_version": 3,
  "name": "Nova Debug",
  "version": "2.1.1",
  "description": "Nova Debug 서버 응답을 DevTools 패널에서 조회",
  "browser_specific_settings": {
    "gecko": {
      "id": "nova-debug@ubik.co.kr",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "devtools_page": "devtools/devtools.html",
  "background": {
    "scripts": ["lib/protocol.js", "background/header-inject.js", "background/icon-state.js", "background/main.js"]
  },
  "action": {
    "default_title": "Nova Debug",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16-off.png",
      "32": "icons/icon32-off.png",
      "48": "icons/icon48-off.png",
      "128": "icons/icon128-off.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Ctrl+F12", "mac": "Command+F12" },
      "description": "현재 사이트 Nova Debug on/off"
    }
  },
  "permissions": ["storage", "webRequest", "webRequestBlocking", "scripting", "clipboardWrite", "webNavigation", "tabs"],
  "host_permissions": ["<all_urls>"],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
