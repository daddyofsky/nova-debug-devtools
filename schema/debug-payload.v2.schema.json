{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/daddyofsky/nova-debug-devtools/main/schema/debug-payload.v2.schema.json",
  "title": "Nova Debug Payload v2",
  "description": "Framework-neutral debug payload emitted by a single HTTP request. See SCHEMA.md for full field-by-field documentation and version history.",
  "type": "object",
  "required": ["schemaVersion", "meta", "summary", "thresholds", "files", "frames", "entries", "timeline"],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": { "type": "object" }
  },
  "properties": {
    "schemaVersion": { "const": 2 },

    "meta": {
      "type": "object",
      "required": ["id", "generator", "runtime", "dirRoot"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "description": "요청 식별자 (파일명/조회 키로 사용)" },
        "generator": { "type": "string", "description": "생산자 이름/버전, 예: nova-debug/20260618a" },
        "request": {
          "type": "object",
          "required": ["uri", "date"],
          "additionalProperties": false,
          "properties": {
            "uri": { "type": "string" },
            "date": { "type": "string", "format": "date-time", "description": "ISO 8601, 타임존 오프셋 포함 (예: 2026-07-20T14:30:00+09:00)" }
          }
        },
        "runtime": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "description": "런타임/언어 이름(소문자 관례), 예: php" },
            "version": { "type": "string", "description": "런타임 버전 문자열 (레퍼런스 구현 기준: PHP_VERSION)" }
          }
        },
        "ide": {
          "type": "object",
          "description": "IDE 딥링크 생성에 필요한 설정. 필드 전부 선택적 — 브라우저 확장(ext) 출력은 serverPath만 보내고 나머지는 확장 옵션(도메인별 매핑)에서 채운다. in-page(window.__debugData) 출력은 서버 설정 전체를 보낸다.",
          "additionalProperties": false,
          "properties": {
            "protocol": { "type": "string", "description": "예: phpstorm, idea, vscode" },
            "serverPath": { "type": "string", "description": "서버(운영/개발서버)에서의 프로젝트 루트 절대경로" },
            "localPath": { "type": "string", "description": "개발자 로컬 머신에서의 프로젝트 루트 절대경로 (serverPath를 이 값으로 치환)" },
            "project": { "type": "string", "description": "IDE 프로젝트명 (phpstorm/idea 링크의 &project=)" }
          }
        },
        "dirRoot": {
          "type": "string",
          "description": "files[].path / frames[].file 이 상대경로로 저장된 기준 절대경로. 절대경로 = dirRoot + path"
        },
        "transport": {
          "type": "object",
          "description": "logApiUrl은 in-page(window.__debugData) 출력에만 포함된다. 브라우저 확장(ext) 저장 JSON은 확장이 자체 설정(기본 경로 + origin별 오버라이드)으로 fetch URL을 구성하므로 생략된다.",
          "required": ["cookieName", "cookieOn"],
          "additionalProperties": false,
          "properties": {
            "logApiUrl": { "type": "string" },
            "cookieName": { "type": "string" },
            "cookieOn": { "type": "boolean" }
          }
        }
      }
    },

    "summary": {
      "type": "object",
      "required": ["time", "memory"],
      "additionalProperties": false,
      "properties": {
        "time": {
          "type": "object",
          "required": ["total", "debug"],
          "additionalProperties": false,
          "properties": {
            "total": { "type": "number", "description": "요청 총 소요시간(초). timeline/entries의 time·duration 백분율 계산 분모." },
            "debug": { "type": "number", "description": "디버그 라이브러리 자체 처리시간(초)" }
          }
        },
        "memory": {
          "type": "object",
          "required": ["usage", "peak"],
          "additionalProperties": false,
          "properties": {
            "usage": { "type": "integer" },
            "peak": { "type": "integer" }
          }
        },
        "queries": {
          "type": "object",
          "required": ["count", "time", "slow", "dup", "loop", "avg", "max", "maxIndex"],
          "additionalProperties": false,
          "properties": {
            "count": { "type": "integer" },
            "time": { "type": "number", "description": "쿼리 총 소요시간(초)" },
            "slow": {
              "type": "object",
              "required": ["count", "time"],
              "additionalProperties": false,
              "properties": {
                "count": { "type": "integer" },
                "time": { "type": "number" }
              }
            },
            "dup": {
              "type": "object",
              "required": ["total", "patterns", "percent"],
              "additionalProperties": false,
              "properties": {
                "total": { "type": "integer", "description": "DUP로 표시된 쿼리 개수" },
                "patterns": { "type": "integer", "description": "DUP fingerprint 그룹 수" },
                "percent": { "type": "number" }
              }
            },
            "loop": {
              "type": "object",
              "required": ["total", "sites", "byType"],
              "additionalProperties": false,
              "properties": {
                "total": { "type": "integer", "description": "LOOP로 표시된 쿼리 개수" },
                "sites": { "type": "integer", "description": "LOOP 호출 지점(같은 fingerprint+trace) 수" },
                "byType": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["table", "count"],
                    "additionalProperties": false,
                    "properties": {
                      "table": { "type": "string" },
                      "count": { "type": "integer" }
                    }
                  }
                }
              }
            },
            "avg": { "type": "number", "description": "쿼리 평균 소요시간(초). 페이로드 전체 시간 필드와 단위 통일 — ms 표시는 소비측이 계산." },
            "max": { "type": "number", "description": "쿼리 최대 소요시간(초). 페이로드 전체 시간 필드와 단위 통일 — ms 표시는 소비측이 계산." },
            "maxIndex": { "type": "integer", "description": "최대 소요시간 쿼리의 entries[].index" }
          }
        },
        "files": {
          "type": "object",
          "required": ["count"],
          "additionalProperties": false,
          "properties": {
            "count": { "type": "integer", "description": "get_included_files() 등 '로드된 파일' 개수. files[] 배열 길이는 이보다 클 수 있다(§files 참조)." }
          }
        },
        "logs": {
          "type": "object",
          "description": "type=log 엔트리 집계. 선택 — 로그를 생산하지 않으면 이 키 자체를 생략한다.",
          "required": ["count", "byLevel"],
          "additionalProperties": false,
          "properties": {
            "count": { "type": "integer", "description": "type=log 엔트리 총 개수" },
            "byLevel": {
              "type": "object",
              "description": "PSR-3 레벨명 => 해당 레벨 개수",
              "propertyNames": { "enum": ["debug", "info", "notice", "warning", "error", "critical", "alert", "emergency"] },
              "additionalProperties": { "type": "integer" }
            }
          }
        }
      }
    },

    "thresholds": {
      "type": "object",
      "required": ["slowQueryTime", "tooManyCount"],
      "additionalProperties": false,
      "properties": {
        "slowQueryTime": { "type": "number", "description": "이 값(초) 초과 쿼리를 SLOW로 표시" },
        "tooManyCount": { "type": "integer", "description": "배열/객체 원소 수가 이 값 이상이면 경고 표시 (2차원 배열은 완화된 배수 적용은 소비측 재량)" }
      }
    },

    "files": {
      "type": "array",
      "description": "로드된 파일 경로 테이블(dirRoot 상대). frames[].file 이 이 배열을 인덱스로 참조한다. 배열 길이가 summary.files.count 보다 클 수 있다 — trace가 참조하지만 get_included_files()엔 없는 드문 경로(eval 등)를 뒤쪽에 추가 수용하기 때문. 'Files' 탭 등 UI 카운트는 summary.files.count 기준으로 표시할 것.",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "description": "dirRoot 기준 상대경로 (선행 슬래시 포함)" },
          "original": { "type": "string", "description": "템플릿 캐시 파일의 원본 경로 매핑 (해당하는 경우만)" }
        }
      }
    },

    "frames": {
      "type": "array",
      "description": "요청 전체에서 유일한 (file,line,func,args,argsFull) 조합만 담는 dedup 테이블. entries[].trace 는 이 배열의 인덱스 목록이다.",
      "items": {
        "type": "object",
        "required": ["file", "line", "func", "args", "argsFull"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": ["integer", "null"], "description": "files[] 인덱스. 네이티브 함수 등 파일이 없으면 null." },
          "line": { "type": ["integer", "null"], "description": "file이 null이면(정보 없음) line도 null." },
          "func": { "type": "string", "description": "생산자가 포맷한 불투명 표시 문자열(예: Class::method). 소비자는 파싱하지 말고 그대로 표시할 것." },
          "args": { "type": "string", "description": "요약된 인자 표시 문자열 — 생산자가 포맷한 불투명 문자열." },
          "argsFull": { "type": "string", "description": "펼친 인자 상세 표시 문자열 — 생산자가 포맷한 불투명 문자열." }
        }
      }
    },

    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },

    "timeline": {
      "type": "array",
      "description": "타임스탬프 체크포인트 구간. 퍼센트(left/width)는 소비측이 start/duration 을 summary.time.total 로 나눠 계산한다.",
      "items": {
        "type": "object",
        "required": ["name", "start", "duration"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "start": { "type": "number", "description": "요청 시작 대비 오프셋(초)" },
          "duration": { "type": "number", "description": "구간 소요시간(초)" }
        }
      }
    },

    "x-nova": {
      "type": "object",
      "description": "Nova 프레임워크 벤더 확장. 범용 소비자는 무시해도 된다.",
      "additionalProperties": true,
      "properties": {
        "fileHighlight": {
          "type": "object",
          "description": "경로 부분문자열 => 강조색 매핑 (파일 목록 렌더링용)",
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "x-php": {
      "type": "object",
      "description": "PHP 레퍼런스 구현 벤더 확장. 범용 소비자는 무시해도 된다.",
      "additionalProperties": true,
      "properties": {
        "opcache": { "type": "boolean", "description": "opcache 확장 활성 여부" }
      }
    },

    "request": {
      "type": "object",
      "description": "선택 — 요청 컨텍스트(파라미터/헤더/쿠키/세션/응답 status). meta.request(uri/date)와 역할이 분리된다: meta.request는 항상 존재하는 요청 식별 메타데이터이고, 이 섹션은 선택적으로 수집되는 상세 컨텍스트다. 생산자는 저장 전 마스킹·크기 제한 규칙(SCHEMA.md §12)을 적용해야 한다.",
      "required": ["method", "status", "contentType"],
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "description": "HTTP 메서드, 예: GET/POST" },
        "status": { "type": "integer", "description": "응답 status 코드" },
        "contentType": { "type": "string", "description": "응답 Content-Type" },
        "route": { "type": "string", "description": "선택 — 생산자가 포맷한 라우트 패턴 표시 문자열(예: /users/{id}). frames[].func 와 동일하게 불투명 표시 문자열이며 소비자는 파싱하지 않는다." },
        "handler": { "type": "string", "description": "선택 — 생산자가 포맷한 핸들러(컨트롤러) 표시 문자열(예: UserController::show). frames[].func 와 동일한 관례." },
        "get": {
          "type": "object",
          "description": "GET 쿼리 파라미터. 값은 생산자가 표시용으로 평탄화한 문자열(SCHEMA.md §12) — 중첩 파라미터(PHP a[b]=1 등)는 키를 'a[b]' 형태로 평탄화해 표현한다. 마스킹 대상 키는 값이 '***'로 치환된다.",
          "additionalProperties": { "type": "string" }
        },
        "post": {
          "type": "object",
          "description": "파싱된 POST 파라미터만 수록(raw body 금지). 값 표현·마스킹은 get과 동일.",
          "additionalProperties": { "type": "string" }
        },
        "cookies": {
          "type": "object",
          "description": "요청 쿠키. 마스킹 대상 키(SCHEMA.md §12)는 값이 '***'로 치환된다.",
          "additionalProperties": { "type": "string" }
        },
        "session": {
          "type": "object",
          "description": "세션 데이터. 값 표현·마스킹은 cookies와 동일.",
          "additionalProperties": { "type": "string" }
        },
        "requestHeaders": {
          "type": "object",
          "description": "요청 헤더. 값은 문자열(복수 헤더는 생산자가 ', '로 결합 — HTTP 관례). 마스킹 대상 헤더(Authorization/Cookie 등)는 값이 '***'로 치환된다.",
          "additionalProperties": { "type": "string" }
        },
        "responseHeaders": {
          "type": "object",
          "description": "응답 헤더. 값 표현·마스킹은 requestHeaders와 동일.",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  },

  "$defs": {
    "entry": {
      "type": "object",
      "required": ["index", "type", "time", "duration", "label", "dump", "trace"],
      "additionalProperties": { "type": "object", "description": "신규 타입의 서브객체(타입명=키, 예: http{}, event{}). 알려진 필드(index/type/time/duration/label/dump/trace/truncated/array/object/query/log/exception)의 오타는 properties에 명시된 스칼라/객체 타입 검사에서 걸러지고, 미지 키는 객체 값만 허용한다." },
      "properties": {
        "index": { "type": "integer" },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "항목 종류. 알려진 값은 dump/query/array(§SCHEMA.md 타입 표). 신규 타입은 등록 절차를 따라 추가되며, 소비자는 미지의 값을 만나면 label+dump+trace만으로 generic 렌더링해야 한다."
        },
        "time": { "type": "number", "description": "요청 시작 대비 오프셋(초)" },
        "duration": { "type": "number", "description": "소요시간(초). 대부분 쿼리에서만 0보다 큼." },
        "label": { "type": "string" },
        "dump": { "type": "string", "description": "생산자가 문자열로 포맷한 값 텍스트(레퍼런스 구현 기준: PHP print_r()). ext 채널에서는 ext.dumpMaxLength 기준으로 절단될 수 있다." },
        "truncated": { "type": "boolean", "description": "선택 — dump가 생산자 측에서 truncate(절단)됐는지 표시. 부재는 '알 수 없음/비절단'을 의미한다(false와 동일하게 취급). true일 때만 포함하는 것을 권장하나 false로 명시해도 유효하다." },
        "trace": {
          "type": "array",
          "description": "frames[] 인덱스 목록(호출 스택 최상단이 먼저). 화면 표시용 호출 번호(1,2,3..)는 소비측이 trace.length - position 으로 계산한다.",
          "items": { "type": "integer" }
        },
        "array": {
          "type": "object",
          "description": "type=array 일 때만 존재",
          "required": ["depth", "count"],
          "additionalProperties": false,
          "properties": {
            "depth": { "type": "integer", "description": "0: 빈 배열, 1: 1차원, 2: 원소가 배열/객체(다차원)" },
            "count": { "type": "integer" }
          }
        },
        "object": {
          "type": "object",
          "description": "type=dump 이고 값이 예외/오류 객체가 아닌 일반 객체일 때만 존재(레퍼런스 구현 기준: PHP Throwable 제외)",
          "required": ["className"],
          "additionalProperties": false,
          "properties": {
            "className": { "type": "string" },
            "count": { "type": "integer", "description": "num_rows() 등 결과셋 행 수 (해당하는 경우만)" }
          }
        },
        "query": {
          "type": "object",
          "description": "type=query 일 때만 존재",
          "additionalProperties": false,
          "properties": {
            "table": { "type": "string", "description": "선택 — 비테이블 저장소(캐시 등) 쿼리는 생략 가능" },
            "connection": { "type": "string", "description": "선택 — 다중 DB 커넥션 구분 라벨(예: \"default\", \"mysql_read\"). 단일 커넥션만 쓰는 생산자는 생략 가능." },
            "bindings": {
              "type": "array",
              "description": "선택 — prepared statement 파라미터 목록(순서대로). SQL 원문(dump)은 값이 보간됐는지 여부와 무관하게 항상 그대로 유지되며, bindings는 생산자가 파라미터를 별도로 확보했을 때만 추가 제공한다.",
              "items": { "type": ["string", "number", "boolean", "null"] }
            },
            "warn": { "type": "boolean", "description": "EXPLAIN 상 주의 필요(ALL scan, filesort 등). 선택 — 부재는 '분석 안 함', false는 '분석했고 정상'을 의미한다." },
            "explainHtml": {
              "type": "string",
              "description": "[deprecated] 드라이버가 생성한 EXPLAIN 결과 HTML 조각. query.explain(원시 구조)으로 대체되며 병행 기간 후 제거 예정 — 범용 소비자는 explain을 우선 사용하고, explainHtml은 과도기 레거시 소비자 호환용으로만 참조한다. 값이 있을 때만 포함."
            },
            "explain": {
              "type": "object",
              "description": "EXPLAIN 결과의 DB 엔진 중립 원시 구조. explainHtml을 대체하는 정식 필드. format에 따라 세 가지 형태 중 하나만 채워진다(§SCHEMA.md §7). 값이 있을 때만 포함.",
              "required": ["format"],
              "additionalProperties": false,
              "properties": {
                "format": {
                  "enum": ["table", "text", "json"],
                  "description": "table: MySQL/SQLite 등 컬럼-행 형태. text: PostgreSQL EXPLAIN 등 행 텍스트. json: PG FORMAT JSON/MSSQL 등 구조화 출력."
                },
                "columns": {
                  "type": "array",
                  "description": "format=table 일 때만: 컬럼명 목록",
                  "items": { "type": "string" }
                },
                "rows": {
                  "type": "array",
                  "description": "format=table 일 때만: 행 배열. 각 행은 columns와 같은 순서의 셀 배열. 셀 타입은 문자열로 강제하지 않고 scalar/null을 허용한다 — DB 드라이버(mysqli/PDO/SQLite3)마다 EXPLAIN 결과의 숫자 컬럼(rows/filtered 등)을 문자열 또는 정수로 반환하는 방식이 달라, 스키마 단에서 문자열 강제 시 생산자가 매번 캐스팅해야 하고 원본 타입 정보(NULL 여부 등)를 잃기 때문.",
                  "items": {
                    "type": "array",
                    "items": { "type": ["string", "number", "boolean", "null"] }
                  }
                },
                "text": {
                  "type": "string",
                  "description": "format=text 일 때만: EXPLAIN 결과 텍스트 원문(줄바꿈 포함)"
                },
                "json": {
                  "description": "format=json 일 때만: EXPLAIN 결과 JSON 구조(엔진별 스키마가 달라 형태를 제한하지 않음)"
                }
              },
              "allOf": [
                {
                  "if": { "required": ["format"], "properties": { "format": { "const": "table" } } },
                  "then": {
                    "required": ["columns", "rows"],
                    "properties": { "text": false, "json": false }
                  }
                },
                {
                  "if": { "required": ["format"], "properties": { "format": { "const": "text" } } },
                  "then": {
                    "required": ["text"],
                    "properties": { "columns": false, "rows": false, "json": false }
                  }
                },
                {
                  "if": { "required": ["format"], "properties": { "format": { "const": "json" } } },
                  "then": {
                    "required": ["json"],
                    "properties": { "columns": false, "rows": false, "text": false }
                  }
                }
              ]
            },
            "dup": {
              "type": "object",
              "required": ["count", "group"],
              "additionalProperties": false,
              "properties": {
                "count": { "type": "integer" },
                "group": { "type": "string" }
              }
            },
            "loop": {
              "type": "object",
              "required": ["count", "group", "sig"],
              "additionalProperties": false,
              "properties": {
                "count": { "type": "integer" },
                "group": { "type": "string" },
                "sig": { "type": "string", "description": "loop로 묶인 근거가 된 trace file:line 시그니처" }
              }
            }
          }
        },
        "log": {
          "type": "object",
          "description": "type=log 일 때만 존재. 로그 메시지 본문은 entry.dump(문자열)를 그대로 재사용한다(별도 message 필드 없음).",
          "required": ["level"],
          "additionalProperties": false,
          "properties": {
            "level": {
              "enum": ["debug", "info", "notice", "warning", "error", "critical", "alert", "emergency"],
              "description": "PSR-3 로그 레벨 8종"
            },
            "context": {
              "type": "object",
              "description": "PSR-3 context 배열에 대응하는 부가 데이터. 값 타입은 제한하지 않음"
            }
          }
        },
        "exception": {
          "description": "type=exception 일 때만 존재",
          "$ref": "#/$defs/exception"
        }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "array" } } },
          "then": {
            "required": ["array"],
            "properties": { "object": false, "query": false, "log": false, "exception": false }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "query" } } },
          "then": {
            "required": ["query"],
            "properties": { "array": false, "object": false, "log": false, "exception": false }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "dump" } } },
          "then": {
            "properties": { "array": false, "query": false, "log": false, "exception": false }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "log" } } },
          "then": {
            "required": ["log"],
            "properties": { "array": false, "object": false, "query": false, "exception": false }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "exception" } } },
          "then": {
            "required": ["exception"],
            "properties": { "array": false, "object": false, "query": false, "log": false }
          }
        }
      ]
    },
    "exception": {
      "type": "object",
      "description": "예외/오류 표현(엔트리의 exception 서브객체, previous 체이닝에도 재사용되는 재귀 정의)",
      "required": ["class", "message", "file", "line", "trace"],
      "additionalProperties": false,
      "properties": {
        "class": { "type": "string", "description": "예외 클래스명" },
        "message": { "type": "string" },
        "code": {
          "type": ["integer", "string"],
          "description": "예외 코드. PHP 예외 코드는 관례상 int이나 PDOException 등 SQLSTATE 문자열 코드를 반환하는 사례가 있어 integer|string 모두 허용"
        },
        "file": {
          "type": ["integer", "null"],
          "description": "예외가 발생한 파일 — files[] 인덱스. 파일 정보가 없으면(네이티브 함수 등) null"
        },
        "line": { "type": ["integer", "null"], "description": "예외가 발생한 라인. file이 null이면(정보 없음) line도 null." },
        "trace": {
          "type": "array",
          "description": "frames[] 인덱스 배열(entries[].trace와 동일 관례, 스택 최상단이 먼저). 예외(throwable) 자체의 스택 — entry.trace(엔트리가 캡처된 지점의 스택)와 값이 같을 수 있으나 의미상 별개 필드다.",
          "items": { "type": "integer" }
        },
        "previous": {
          "description": "체이닝된 이전 예외(재귀). 없으면 필드 자체를 생략",
          "$ref": "#/$defs/exception"
        }
      }
    }
  }
}
